<?xml version="1.0"?>
<ruleset name="complexidade-ciclomatica"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
  <description>CC de todas as classes e métodos (limites em 1 para listar tudo).</description>
  <rule ref="category/java/design.xml/CyclomaticComplexity">
    <properties>
      <property name="classReportLevel" value="1"/>
      <property name="methodReportLevel" value="1"/>
    </properties>
  </rule>
</ruleset>
